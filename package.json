{
  "name": "ztask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0 <21 || >=22.0.0 <26"
  },
  "scripts": {
    "test:gates": "node --test scripts/prototype-tracker.spec.mjs && vitest run scripts --exclude scripts/prototype-tracker.spec.mjs",
    "lint:docs": "node scripts/run-gates.mjs --mode doc-quick",
    "verify:docs": "node scripts/run-gates.mjs --mode doc-sync",
    "verify:flow": "node scripts/verify-flow.mjs",
    "verify:flow-online": "node scripts/verify-flow-online.mjs",
    "flow:sync": "node scripts/flow-sync.mjs",
    "flow:new-issue": "node scripts/flow-new-issue.mjs",
    "record:i18n": "node scripts/verify-translation-pairing.mjs --write",
    "archive:note": "node scripts/archive-agent-note.mjs",
    "route:gates": "node scripts/route-gates.mjs",
    "install:hooks": "node scripts/install-git-hooks.mjs",
    "install-merge-driver": "node scripts/install-merge-driver.mjs",
    "test:prototype": "node --test scripts/prototype-tracker.spec.mjs",
    "test": "pnpm build && pnpm test:gates && vitest run apps tests",
    "package:smoke": "node scripts/package-smoke.mjs",
    "pack:ztask": "pnpm --filter ./apps/ztask pack",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --stream dev",
    "typecheck": "pnpm -r typecheck",
    "serve": "node apps/cli/dist/cli.js serve"
  },
  "devDependencies": {
    "@redocly/ajv": "8.11.2",
    "@types/node": "^22.19.3",
    "@ztask/cli": "workspace:*",
    "@ztask/server": "workspace:*",
    "@ztask/shared": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vue": "^3.5.24",
    "@tanstack/vue-query": "^5.95.0",
    "vue-router": "^4.6.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "light-my-request": "6.6.0"
    }
  }
}
